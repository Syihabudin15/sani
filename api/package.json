{
  "name": "syrel-analysis-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.6.2",
    "fastify-plugin": "^6.0.1",
    "mariadb": "^3.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
